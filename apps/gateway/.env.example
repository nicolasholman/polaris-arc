# Copy to apps/gateway/.env (git-ignored) and fill in what you have.
#
# The gateway serves @polarispay/underwriting's HTTP API. A buyer's Polaris
# account is read from Arc (its public RPC and Blockscout explorer, no key).
# Nansen, Zerion and Etherscan read an optional linked history wallet on other
# chains: a provider without its key is not configured: it is never called,
# its facts are absent, and /health names the missing variable. There is no
# fixture mode (UNDERWRITING_MODE=fixture is refused).

# Where to listen. Without UNDERWRITING_API_TOKEN only loopback is allowed.
PORT=3510
HOST=127.0.0.1

# Required before this listens anywhere but localhost: the app's server sends
# "Authorization: Bearer <token>". Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UNDERWRITING_API_TOKEN=

# Browser origins allowed to call directly (comma-separated). Never "*".
UNDERWRITING_CORS_ORIGINS=

# --- The account chain (Arc) ---------------------------------------------------
# 5042002 Arc testnet (default) or 5042 Arc mainnet. Any other id is a custom
# chain (e.g. a local Hardhat node) and needs the RPC URL and tokens below.
UNDERWRITING_ACCOUNT_CHAIN_ID=5042002
# Default: https://rpc.testnet.arc.io (mainnet: https://rpc.mainnet.arc.io).
UNDERWRITING_ACCOUNT_RPC_URL=
# Blockscout's Etherscan-style API. Default: https://explorer.testnet.arc.io/api
# (mainnet: https://explorer.arc.io/api). "none" for a chain with no explorer.
UNDERWRITING_ACCOUNT_EXPLORER_API_URL=
# Comma-separated 6-decimal dollar tokens whose balances count. Default: Arc's
# USDC (0x3600000000000000000000000000000000000000) and EURC.
UNDERWRITING_ACCOUNT_TOKENS=

# --- A linked history wallet (optional, keyed) ---------------------------------
# Nansen (https://app.nansen.ai/api): first funder, related wallets, fallbacks.
NANSEN_API_KEY=
# 1: spend 100 credits per linked wallet on the labels endpoint for the risk screen.
NANSEN_LABELS=0
# Zerion (https://dashboard.zerion.io): exact balances, tenure probes.
ZERION_API_KEY=
# Etherscan V2 (https://etherscan.io/myapikey): past liquidations on Ethereum, Arbitrum, Polygon.
ETHERSCAN_API_KEY=
# History chains' RPCs (the linked wallet's nonces). Defaults: public Ethereum,
# Base and Arc mainnet endpoints.
RPC_URL_1=
RPC_URL_8453=
RPC_URL_5042=

# 1: underwrite conservatively instead of asking the app to retry when a source is down.
UNDERWRITING_ALLOW_PARTIAL=0
