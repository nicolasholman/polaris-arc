# Copy to apps/gateway/.env (git-ignored) and fill in what you have.
# A provider without its key is not configured: it is never called, its facts
# are absent, and /health names the missing variable. There is no fixture mode.

PORT=3510
HOST=127.0.0.1

# Required before this listens anywhere but localhost: the app's server sends
# "Authorization: Bearer <token>". Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UNDERWRITING_API_TOKEN=

# Browser origins allowed to call directly (comma-separated). Never "*".
UNDERWRITING_CORS_ORIGINS=

# Nansen (https://app.nansen.ai/api): first funder, related wallets, fallbacks.
NANSEN_API_KEY=
# Spend 100 credits per linked wallet on the labels endpoint for the risk screen.
NANSEN_LABELS=0

# Zerion (https://dashboard.zerion.io): balances, tenure probes, the account's testnet history.
ZERION_API_KEY=

# Etherscan V2 (https://etherscan.io/myapikey): past liquidations, testnet token transfers.
ETHERSCAN_API_KEY=


# 1: underwrite conservatively instead of asking the app to retry when a source is down.
UNDERWRITING_ALLOW_PARTIAL=0

# Optional RPC overrides. Defaults: Monad testnet and public Ethereum, Base and Monad RPCs.
MONAD_TESTNET_RPC_URL=
RPC_URL_1=
RPC_URL_8453=
RPC_URL_143=
