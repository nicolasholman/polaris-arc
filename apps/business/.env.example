# Polaris for Business. Copy to .env.local and fill in. Every value here is
# read on the server only unless it starts with NEXT_PUBLIC_.
#
# ── Hosted (Vercel; docs/HOSTED.md) ──────
# Vercel functions with an existing Atlas database. NEXT_PUBLIC_* are compiled into the
# browser bundle, so in the image they are build arguments (fly.toml
# Vercel project environment variables); the
# rest are runtime secrets (`fly secrets import`). The image sets
# POLARIS_DB_URL=mongodb+srv://... and POLARIS_MONGO_DB=arc_polaris_testnet,
# POLARIS_WORKERS=0 and POLARIS_DEPLOYMENT=arc-testnet. Production needs at
# least: PRIVY_APP_ID, PRIVY_APP_SECRET, POLARIS_KEY_PEPPER, CRON_SECRET,
# POLARIS_CHECKOUT_ORIGIN, POLARIS_PUBLIC_URL, POLARIS_TRUSTED_PROXIES=1 and a
# relayer (RELAYER_MODE). GET /api/health/ready is the readiness check;
# scripts/deploy-check.mjs checks the whole deployment.
# The image builds with POLARIS_NEXT_OUTPUT=standalone (Next's standalone
# server); leave it unset for `next build && next start`.

# ── Privy: sign-in (client + server) ─────────────────────────────────────────
# Dashboard > App settings. Without it the app renders a setup screen and every
# dashboard route answers 503. The checkout API and the relayer don't need it.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional: an "app client" ID, if you created one for this origin.
NEXT_PUBLIC_PRIVY_CLIENT_ID=
# PRIVY_APP_ID falls back to NEXT_PUBLIC_PRIVY_APP_ID when unset.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: Dashboard > Configuration > App settings > Verification key.
PRIVY_VERIFICATION_KEY=

# ── The dashboard's own signing (client) ─────────────────────────────────────
# USDC, for withdrawals the payout wallet signs in the browser. Unset: read from
# /api/public/network (the deployment record). USDC on Arc (testnet and mainnet)
# is 0x3600000000000000000000000000000000000000, EIP-712 name "USDC", version "2".
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_USDC_EIP712_NAME=USDC
NEXT_PUBLIC_USDC_EIP712_VERSION=2

# ── Chain ────────────────────────────────────────────────────────────────────
# The deployment record the server serves: packages/contracts/deployments/<name>.json
# (arc-testnet after `deploy:testnet`, arc-mainnet after `deploy:mainnet`), or a path.
POLARIS_DEPLOYMENT=arc-testnet
# POLARIS_DEPLOYMENT_FILE=../../packages/contracts/deployments/arc-local.json   # a local Hardhat node
# POLARIS_DEPLOYMENT=arc-mainnet   # Arc mainnet (chain 5042)
# Our own RPC (default: Arc testnet's public one). Arc's public RPC caps
# eth_getLogs at 100 blocks; the chain sync reads in 100-block ranges there.
POLARIS_RPC_URL=
# POLARIS_EXPLORER_URL=https://explorer.testnet.arc.io   # default from the deployment record
# POLARIS_SYNC_FROM_BLOCK=   # first block the chain sync reads (default: the current one)
# (the deployment's first block is the default: the record has each contract's block)

# ── The relayer (docs/research/privy.md §5.5) ───────────────────────────────
# privy: a policy-locked Privy server wallet signs every relayed call
#        (created by `pnpm --filter @polaris/business privy:setup-relayer -- --apply`).
#        On Arc testnet it is 0x8366916019bc5452e62A0D36418ABebB45396aE2, which
#        holds the operator roles (apps/business/privy-live.md).
# local: a raw key, for a local Hardhat node (the e2e run). Never on mainnet. On
#        Arc testnet only with RELAYER_LOCAL_ALLOW_TESTNET=1: the earlier dev relayer
#        0x5e6934725eBCdfcA2d95D991045Fa813B51E2c69 still holds its roles (its key is
#        TESTNET_RELAYER_PRIVATE_KEY in the git-ignored repo-root .env).
# off:   checkout sessions work, nothing is relayed.
RELAYER_MODE=off
PRIVY_RELAYER_WALLET_ID=
PRIVY_RELAYER_ADDRESS=
PRIVY_RELAYER_AUTH_KEY=
# RELAYER_PRIVATE_KEY=       # RELAYER_MODE=local only
# RELAYER_LOCAL_ALLOW_TESTNET=1   # RELAYER_MODE=local on Arc testnet, knowingly (never allowed on mainnet)
RELAYER_RECEIPT_TIMEOUT_MS=15000
# What the relayer won't spend its USDC (gas) on, whoever asks. The smallest USDC transfer or
# send by link it carries, in base units (also a condition in the Privy policy; default
# 100000 = $0.10), and caps on any one transaction's gas limit and fee.
RELAYER_MIN_TRANSFER_UNITS=
RELAYER_MAX_GAS=
RELAYER_MAX_FEE_GWEI=

# ── Merchant activation (MerchantRegistry owner) ─────────────────────────────
# off (default): merchants are registered by signature and activated by the
# protocol owner out of band. privy: a Privy wallet that owns MerchantRegistry
# and may only setActive / setMaxOrderValue up to the cap below.
REGISTRY_ACTIVATOR=off
PRIVY_REGISTRY_WALLET_ID=
PRIVY_REGISTRY_ADDRESS=
PRIVY_REGISTRY_AUTH_KEY=
MERCHANT_ACTIVATION_CAP_USD=1000
# Settlement history before automatic activation: Pay-now orders from this many different
# customers (default 3 in production, 0 in development). Until then a new merchant takes
# Pay now only, so fresh accounts can't draw their opening credit lines on a merchant that
# has never sold anything.
MERCHANT_ACTIVATION_MIN_PAYMENTS=
# Owner of every per-merchant payout policy, so the app secret alone can't widen one.
# Production refuses to create payout policies without it (setup-relayer writes it).
PRIVY_ADMIN_QUORUM_ID=

# ── Automatic payouts (docs/research/privy.md §6) ────────────────────────────
# `pnpm --filter @polaris/business privy:setup-payouts -- --apply` creates these.
NEXT_PUBLIC_PRIVY_PAYOUT_SIGNER_ID=
PRIVY_PAYOUT_SIGNER_ID=
PRIVY_PAYOUT_SIGNER_KEY=

# ── API keys, sessions, webhooks ─────────────────────────────────────────────
# Required in production: HMAC pepper for stored secret-key hashes.
POLARIS_KEY_PEPPER=
# Where links and checkout sessions send the buyer: ${origin}/pay/${id}.
# Required in production (no default): without it links don't go live and sessions answer 503.
POLARIS_CHECKOUT_ORIGIN=http://localhost:3000
# This server's public URL, signed into each merchant's registry metadata.
# Required in production (no default): registration waits for it.
POLARIS_PUBLIC_URL=http://localhost:3100
# Browser origins allowed to call /api/relay and /api/public (the checkout origin is always allowed).
POLARIS_APP_ORIGINS=
POLARIS_SESSION_TTL_SECONDS=86400
# Pay in 4 terms offered on sessions: weekly by default; 60 on the demo deployment.
PAY_IN_4_INTERVAL_SECONDS=604800
PAY_IN_4_MIN_CENTS=2000
PAY_IN_4_MAX_CENTS=100000
# Development only: deliver webhooks to localhost / private addresses.
POLARIS_WEBHOOK_ALLOW_PRIVATE=1

# ── Credit reviews: the Polaris keeper (services/keeper) ──────────────────────
# Where the keeper takes review requests (`pnpm --filter @polaris/keeper start`
# listens on http://127.0.0.1:2000/underwrite). Unset: credit reviews are off
# (POST /api/credit/underwrite answers 503) and Pay now still works.
KEEPER_UNDERWRITING_URL=
# Requests are queued and sent one at a time, at most one per this many ms.
KEEPER_REQUEST_MIN_INTERVAL_MS=2000
# One shared secret, both ways: this server signs review requests to the keeper,
# and the keeper signs its callbacks to /api/keeper/callback. Unset: both closed.
POLARIS_KEEPER_CALLBACK_SECRET=
# The underwriting gateway (apps/gateway, `pnpm --filter @polarispay/gateway start`). An
# attested decision is explained as the buyer's reasons, each with its provider (Nansen,
# Zerion), by @polarispay/underwriting in this server; set this to use the gateway instead.
UNDERWRITING_GATEWAY_URL=
UNDERWRITING_API_TOKEN=

# ── Chain sync: where logs come from ─────────────────────────────────────────
# An indexer's JSON-RPC that serves wide eth_getLogs ranges (e.g. Envio's HyperRPC
# for Arc). The chain sync then reads 10,000 blocks a request instead of the public
# RPC's 2,000. Unset: logs come from POLARIS_RPC_URL.
POLARIS_LOGS_RPC_URL=

# ── Envio: the Polaris indexer ───────────────────────────────────────────────
# The GraphQL endpoint of packages/indexer on Envio Cloud (`envio-cloud deployment
# endpoint`), or http://localhost:8080/v1/graphql under `envio dev`. The Overview's
# "Indexed by Envio" feed reads it through @polarispay/indexer-client. Unset: the feed
# shows this server's own chain sync, labelled as such. POLARIS_INDEXER_TOKEN is sent as
# a Bearer token when your Envio plan needs one.
POLARIS_INDEXER_URL=
POLARIS_INDEXER_TOKEN=

# ── Storage and background work ──────────────────────────────────────────────
# sqlite:<path> (default sqlite:.data/polaris.db) or memory:
POLARIS_DB_URL=
# Background loops in this process (chain sync, webhook retries, payouts). Default on
# in development. On serverless, call POST /api/cron/tick with this secret instead.
POLARIS_WORKERS=
CRON_SECRET=
# How many proxies you run in front of this server (a platform edge, nginx), each of
# which appends to X-Forwarded-For. Per-IP rate limits read the client's address that
# many entries from the right, never the leftmost one a client can write. Production
# warns when it is 0. (POLARIS_TRUST_PROXY=1, the older setting, means 1.)
POLARIS_TRUSTED_PROXIES=

# ── The web app ──────────────────────────────────────────────────────────────
# "See the demo shop" on the landing and in Developers: the Halcyon demo store
# (apps/shop), which pays through polarispay-sdk. `pnpm dev:demo` at the repo root
# runs it beside this app on http://127.0.0.1:3600. In development the buttons
# check the shop answers first and read "Demo shop coming soon" when it doesn't;
# a production build without this value shows them disabled.
NEXT_PUBLIC_DEMO_SHOP_URL=http://127.0.0.1:3600

# ── Optional ─────────────────────────────────────────────────────────────────
# The Arc testnet RPC Privy's embedded wallet uses (default: Privy's own).
# NEXT_PUBLIC_ARC_TESTNET_RPC=https://rpc.testnet.arc.io
# NEXT_PUBLIC_CHAIN_ID=5042002   # 5042 for Arc mainnet
# NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.arc.io

# ── pnpm demo:local only (development, a local chain, Privy off) ─────────────
# scripts/demo-local.mjs sets all of these for its run; nothing to set by hand.
# The server refuses them in production, off a local chain, or with Privy on
# (src/server/env.ts localSessionFrom), and next.config.ts blanks the public
# ones outside `next dev`.
# Turn Privy off entirely (no sign-in modal, no Privy calls).
# POLARIS_DISABLE_PRIVY=1
# The signed-in local session: a random token (32+ letters, digits, - or _) and
# the merchant's payout wallet it signs in as.
# POLARIS_LOCAL_SESSION_TOKEN=
# POLARIS_LOCAL_SESSION_WALLET=
# The same token and wallet for the browser, and that wallet's throwaway key on
# the local chain (so the dashboard can sign as Privy's embedded wallet would).
# NEXT_PUBLIC_POLARIS_LOCAL_SESSION=
# NEXT_PUBLIC_POLARIS_LOCAL_SESSION_WALLET=
# NEXT_PUBLIC_POLARIS_LOCAL_SESSION_KEY=

# Cross-chain (optional). Circle Gateway API (defaults by network) and the Arc mainnet RPC the
# Chainlink EURC / USD and USDC / USD rates are read from for display.
# CIRCLE_GATEWAY_API_URL=https://gateway-api-testnet.circle.com
# ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io

# Existing Atlas database, isolated from Monad; no new service required.
# POLARIS_MONGO_DB=arc_polaris_testnet
