{
  "name": "@polaris/business",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Polaris for Business: the merchant landing, sign-in and dashboard. Privy login and payout wallet, payment links, payments, the Pay in 4 ledger, payouts, API keys and webhooks.",
  "scripts": {
    "dev": "node scripts/ensure-deps.mjs && next dev --port 3100",
    "build": "node scripts/ensure-deps.mjs && next build",
    "start": "next start --port 3100",
    "lint": "eslint . && node scripts/check-api-auth.mjs",
    "typecheck": "node scripts/ensure-deps.mjs && tsc --noEmit",
    "test": "node scripts/ensure-deps.mjs && vitest run",
    "e2e:local": "node scripts/e2e-local.mjs",
    "smoke:testnet": "node scripts/smoke-testnet.mjs",
    "smoke:testnet:verify": "node scripts/verify-testnet-results.mjs",
    "dev:merchant": "node scripts/dev-merchant.mjs",
    "privy:setup-relayer": "node scripts/privy/setup-relayer.mjs",
    "privy:setup-payouts": "node scripts/privy/setup-payouts.mjs",
    "privy:prove-policy": "node scripts/privy/prove-policy.mjs",
    "privy:update-relayer-policy": "node scripts/privy/update-relayer-policy.mjs",
    "privy:smoke": "node scripts/privy/smoke-monad.mjs",
    "privy:smoke:harness": "node scripts/privy/smoke-harness.mjs",
    "privy:fund": "node scripts/privy/fund-testnet.mjs",
    "privy:show": "node scripts/privy/show-live.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@polaris/brand": "workspace:*",
    "@polaris/db": "workspace:*",
    "@polaris/receipts": "workspace:*",
    "@polaris/ui": "workspace:*",
    "@polarispay/contracts": "workspace:*",
    "@polarispay/indexer-client": "workspace:*",
    "@polarispay/underwriting": "workspace:*",
    "@privy-io/node": "0.35.0",
    "@privy-io/react-auth": "3.45.0",
    "lenis": "^1.3.26",
    "lucide-react": "1.48.0",
    "motion": "13.4.4",
    "next": "16.3.6",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "polarispay-sdk": "workspace:*",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
