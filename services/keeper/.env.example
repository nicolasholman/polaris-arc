# The Polaris keeper (services/keeper). Copy to the repo's .env.local, or set
# in the host's environment (Railway, Fly, a VM). Run: pnpm --filter @polaris/keeper start

# Which deployment record: packages/contracts/deployments/<name>.json, or a path.
POLARIS_DEPLOYMENT=arc-testnet
# POLARIS_DEPLOYMENT_FILE=/path/to/arc-mainnet.json
# The chain's RPC (default: the record's rpcUrl).
# KEEPER_RPC_URL=https://rpc.testnet.arc.io

# The keeper's key: the only address CollectionsReceiver and UnderwritingReceiver
# accept reports from (the record's roles.keeper). It pays gas in USDC: keep a few
# dollars on it. Unset: read-only (finds due tasks, sends nothing).
POLARIS_KEEPER_PRIVATE_KEY=

# Polaris for Business, for signed callbacks (POST /api/keeper/callback) and to
# accept its signed review requests. The same secret is set on the business server.
POLARIS_API_URL=http://localhost:3100
POLARIS_KEEPER_CALLBACK_SECRET=

# Where reviews are taken (POST /underwrite). Loopback by default.
KEEPER_HOST=127.0.0.1
KEEPER_PORT=2000

# Collections: how often, how many ids to check, how many tasks per report.
KEEPER_COLLECTIONS_INTERVAL_SECONDS=60
KEEPER_RECENT_WINDOW=200
KEEPER_SWEEP_WINDOW=100
KEEPER_MAX_TASKS=40
# 0 never liquidates (plans past grace stay for a person to look at).
KEEPER_LIQUIDATE=1
# The dunning ladder from each task's due time (seconds), and the window at each rung.
KEEPER_BACKOFF_LADDER_SECONDS=21600,86400,259200,604800
KEEPER_BACKOFF_WINDOW_SECONDS=1800
# off: try every due task on every run (demos with minute-long instalments).
# KEEPER_BACKOFF=off

# Credit reviews (@polarispay/underwriting). The account is read on Arc (RPC and
# the Blockscout explorer, keyless). A linked history wallet is read on other
# chains through public RPCs, and through these providers when their keys are set:
NANSEN_API_KEY=
ZERION_API_KEY=
ETHERSCAN_API_KEY=
# UNDERWRITING_ACCOUNT_CHAIN_ID=5042002
# UNDERWRITING_ACCOUNT_RPC_URL=
# UNDERWRITING_ACCOUNT_EXPLORER_API_URL=https://explorer.testnet.arc.io/api
# UNDERWRITING_ACCOUNT_TOKENS=0x3600000000000000000000000000000000000000,0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a
# KEEPER_ALLOW_PARTIAL=1
