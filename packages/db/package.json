{
  "name": "@polaris/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Polaris for Business storage and crypto primitives: a document store (SQLite via node:sqlite, or in memory), the record schema, API-key hashing, and Stripe-shaped webhook signing and delivery.",
