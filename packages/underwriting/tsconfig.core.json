// The core is pure, so it runs anywhere (the keeper, the business app, a browser). No node or dom types
// here, so Buffer, process, fetch, setTimeout, TextEncoder or Intl anywhere in
// src/core fails this check.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": [],
    "noEmit": true,
    "rootDir": "./src/core"
  },
  "include": ["src/core/**/*.ts"],
  "exclude": []
}
