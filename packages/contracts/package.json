{
  "name": "@polarispay/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Polaris contracts on Monad: PolarisCheckout (Pay now, Pay in 4, Subscribe), the BNPL loan engine, credit scores, payments, send-by-link, split-the-bill links, and the Chainlink CRE receivers (collections, underwriting, the pool guardian).",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "abi": "node scripts/export-abi.js",
    "check:monad": "node scripts/check-monad.js",
    "deployer": "node scripts/deployer.js",
    "deploy:monad": "hardhat run scripts/deploy-monad.js --network monadTestnet",
    "fund-pool:monad": "hardhat run scripts/fund-pool.js --network monadTestnet",
    "grant-relayer:monad": "hardhat run scripts/grant-relayer.js --network monadTestnet",
    "verify:monad": "hardhat run scripts/verify-monad.js --network monadTestnet",
    "check:deployment:monad": "hardhat run scripts/check-deployment.js --network monadTestnet",
    "lock-receivers:monad": "hardhat run scripts/lock-receivers.js --network monadTestnet",
    "guardian:monad": "hardhat run scripts/guardian.js --network monadTestnet",
    "redeploy-guardian:monad": "hardhat run scripts/redeploy-guardian.js --network monadTestnet",
    "redeploy-vault:monad": "hardhat run scripts/redeploy-vault.js --network monadTestnet",
    "deploy-split:monad": "hardhat run scripts/deploy-split.js --network monadTestnet",
    "deploy-split:local": "hardhat run scripts/deploy-split.js --network monadLocal",
    "node:local": "hardhat node --hostname 127.0.0.1 --port 8600",
    "deploy:local": "hardhat run scripts/deploy-monad.js --network monadLocal",
    "deploy:fork": "hardhat run scripts/deploy-monad.js --network monadFork",
    "fund-pool:fork": "hardhat run scripts/fork-fund-pool.js --network monadFork",
    "check:deployment:fork": "hardhat run scripts/check-deployment.js --network monadFork",
    "fork:smoke": "hardhat run scripts/fork-smoke.js --network monadFork",
    "lock-receivers:local": "hardhat run scripts/lock-receivers.js --network monadLocal",
    "guardian:local": "hardhat run scripts/guardian.js --network monadLocal",
    "e2e:local": "node scripts/e2e-local.js",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "e2e:sepolia": "hardhat run scripts/e2e.js --network sepolia",
    "seed:sepolia": "hardhat run scripts/seed.js --network sepolia",
    "verify:sepolia": "hardhat run scripts/verify.js --network sepolia"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "chai": "^4.5.0",
    "ethers": "^6.17.0",
    "hardhat": "^2.22.17",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0",
    "dotenv": "^16.4.7"
  },
  "exports": {
    "./abi": {
      "types": "./abi/index.d.ts",
      "import": "./abi/index.mjs",
      "require": "./abi/index.js"
    },
    "./abi/*.json": "./abi/*.json",
    "./deployments/*.json": "./deployments/*.json",
    "./lib/*": "./lib/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "abi",
    "deployments",
    "lib",
    "contracts"
  ]
}
