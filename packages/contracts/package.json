{
  "name": "@polarispay/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Polaris contracts on Arc: PolarisCheckout (Pay now, Pay in 4, Subscribe), the credit pool and loan engine, credit scores, payments, send-by-link in USDC and EURC, split-the-bill links, the credit guard, and the keeper's receivers (collections, underwriting).",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "abi": "node scripts/export-abi.js",
    "node:local": "hardhat node --hostname 127.0.0.1 --port 8600",
    "deploy:local": "NETWORK=local hardhat run scripts/deploy.js --network arcLocal",
    "deploy:testnet": "NETWORK=testnet hardhat run scripts/deploy.js --network arcTestnet",
    "deploy:mainnet": "NETWORK=mainnet hardhat run scripts/deploy.js --network arcMainnet",
    "verify:testnet": "NETWORK=testnet hardhat run scripts/verify.js --network arcTestnet",
    "verify:mainnet": "NETWORK=mainnet hardhat run scripts/verify.js --network arcMainnet",
    "check:testnet": "NETWORK=testnet hardhat run scripts/check.js --network arcTestnet",
    "check:mainnet": "NETWORK=mainnet hardhat run scripts/check.js --network arcMainnet",
    "check:local": "NETWORK=local hardhat run scripts/check.js --network arcLocal",
    "fund-pool:testnet": "NETWORK=testnet hardhat run scripts/fund-pool.js --network arcTestnet",
    "fund-pool:mainnet": "NETWORK=mainnet hardhat run scripts/fund-pool.js --network arcMainnet",
    "test:ccip": "forge test",
    "test:ccip:fork": "ARC_FORK_TESTS=1 forge test",
    "ccip:deploy-sender:base-sepolia": "NETWORK=testnet hardhat run scripts/ccip-deploy-sender.js --network baseSepolia",
    "ccip:deploy-sender:sepolia": "NETWORK=testnet hardhat run scripts/ccip-deploy-sender.js --network ethereumSepolia",
    "ccip:allow-senders:testnet": "NETWORK=testnet hardhat run scripts/ccip-allow-sender.js --network arcTestnet"
  },
  "devDependencies": {
    "@chainlink/contracts": "^1.5.0",
    "@chainlink/contracts-ccip": "^2.0.0",
    "@chainlink/local": "^0.3.1",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@openzeppelin/contracts-4.8.3": "npm:@openzeppelin/contracts@4.8.3",
    "@openzeppelin/contracts-5.3.0": "npm:@openzeppelin/contracts@5.3.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "chai": "^4.5.0",
    "ethers": "^6.17.0",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
    "hardhat": "^2.22.17",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0",
    "dotenv": "^16.4.7"
  },
  "exports": {
    "./abi": {
      "types": "./abi/index.d.ts",
      "import": "./abi/index.mjs",
      "require": "./abi/index.js"
    },
    "./abi/*.json": "./abi/*.json",
    "./deployments/*.json": "./deployments/*.json",
    "./lib/*": "./lib/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "abi",
    "deployments",
    "lib",
    "contracts"
  ]
}
