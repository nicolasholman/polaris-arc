{
  "name": "@polarispay/indexer-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed GraphQL client for the Polaris Envio indexer: the queries the dashboard, the webhook dispatcher, the CRE collections workflow and the Polaris app send.",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./cre": {
      "types": "./src/cre.ts",
      "default": "./src/cre.ts"
    },
    "./documents": {
      "types": "./src/documents.ts",
      "default": "./src/documents.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "graphql": "16.11.0",
    "tsx": "4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
