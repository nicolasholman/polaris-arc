# polaris-indexer: environment. Copy to .env (git-ignored) for `envio dev` /
# `envio start`; the scripts read the same names from the shell. Everything is
# optional: tests, codegen and scripts/live.sh need none of it.

# ── Envio ───────────────────────────────────────────────────────────────────

# HyperSync API token, for local runs against Arc testnet or mainnet
# (`pnpm dev`, `pnpm start`). HyperSync serves Arc (`arc-testnet`, `arc`);
# Envio Cloud needs no token. Create one at https://envio.dev/app/api-tokens
ENVIO_API_TOKEN=

# First block to index. Default: the first Polaris deploy block from the
# deployment record (config.yaml), or 0 while the addresses are placeholders.
# ENVIO_START_BLOCK=

# Blocks to stay behind the chain head. Default 0: Arc's finality is
# deterministic and sub-second, so a block never reorgs.
# ENVIO_BLOCK_LAG=0

# ── scripts/local.sh: GraphQL for a running local chain (Docker) ────────────

# The local chain's JSON-RPC (default http://127.0.0.1:8600, the contracts'
# `pnpm --filter @polarispay/contracts node:local`).
# POLARIS_LOCAL_RPC=http://127.0.0.1:8600

# Its deployment record (default ../contracts/deployments/arc-local.json,
# written by `pnpm --filter @polarispay/contracts deploy:local`).
# POLARIS_LOCAL_DEPLOYMENT=../contracts/deployments/arc-local.json

# Host ports for Postgres, Hasura (GraphQL; admin secret `testing`) and the
# indexer's own HTTP server, and the Docker container / network name prefix.
# POLARIS_INDEXER_PG_PORT=15432
# POLARIS_INDEXER_GRAPHQL_PORT=18080
# POLARIS_INDEXER_METRICS_PORT=19898
# POLARIS_INDEXER_DOCKER_PREFIX=polaris-envio

# ── scripts/live.sh and scripts/record-fixture.mjs: a recorded local chain ──

# Port of the throwaway Hardhat node (record-fixture 3540, live.sh 3541).
# POLARIS_FIXTURE_PORT=3541

# How many times live.sh indexes the same chain (Envio's query answers arrive
# in a different order each run, so ordering bugs show only now and then).
# POLARIS_LIVE_RUNS=1

# ── scripts/wsl.sh (Windows through WSL, and CI) ────────────────────────────

# Work where the files are instead of in a copy on the Linux filesystem
# (the copy is made only when the repo is on a Windows drive, /mnt/*).
# POLARIS_INDEXER_IN_PLACE=1

# Where that copy lives (default ~/.cache/polaris-indexer).
# POLARIS_INDEXER_MIRROR=

# Readers of the indexer (not this package): Polaris for Business takes the
# GraphQL endpoint as POLARIS_INDEXER_URL (and POLARIS_INDEXER_TOKEN for a
# gated endpoint) in apps/business/.env.
