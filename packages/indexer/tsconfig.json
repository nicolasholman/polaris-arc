{
  /* Envio's template tsconfig (envio 3.12.1, blank_template/typescript). */
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2023",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,

    "lib": ["es2023"],
    "types": ["node"]
  },
  "include": ["src", "test", "envio-env.d.ts", ".envio/**/*.d.ts"]
}
