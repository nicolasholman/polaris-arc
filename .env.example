# polaris-arc: the repo root's .env.local (git-ignored) holds the runtime keys the
# services use. Each app documents its own variables in its own .env.example:
#   apps/business/.env.example   Polaris for Business (API, relayer, dashboard)
#   apps/app/.env.example        the buyer app (NEXT_PUBLIC_* only)
#   apps/shop/.env.example       the demo shop
#   services/keeper/.env.example the keeper
#   packages/indexer/.env.example Envio (optional)
#
# The deployer key is NEVER kept here: it lives in its own file outside the repo
# and is sourced only inside the deploy command (MAINNET.md).

# The keeper's EOA (POLARIS_KEEPER_ADDRESS at deploy time; the receivers accept it alone).
POLARIS_KEEPER_PRIVATE_KEY=
POLARIS_KEEPER_ADDRESS=
# The relayer's EOA for RELAYER_MODE=local on testnet (mainnet uses a Privy server wallet).
POLARIS_RELAYER_PRIVATE_KEY=
POLARIS_RELAYER_ADDRESS=
# Shared by the business server and the keeper (signed requests and callbacks).
POLARIS_KEEPER_CALLBACK_SECRET=

# scripts/e2e-testnet.mjs: where the deployer key file is (default ../.deployer/deployer.env),
# and how many testnet USDC the buyer gets.
# DEPLOYER_ENV_FILE=
# E2E_BUYER_USDC=5

# Cross-chain (all optional).
# scripts/ccip-send.mjs (user-run, testnet sources only): a key holding Base/Ethereum Sepolia USDC and gas.
# Export it in your shell for the one command; never write it into this repo.
# PAYER_PRIVATE_KEY=
# Circle Gateway API (default: gateway-api-testnet.circle.com on testnet, gateway-api.circle.com on mainnet).
# CIRCLE_GATEWAY_API_URL=
# Where Chainlink's EURC / USD and USDC / USD feeds are read for display (Arc mainnet).
# ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
