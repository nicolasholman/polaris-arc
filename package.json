{
  "name": "polaris-arc",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Polaris on Arc: Stripe for every app on Arc. Payment links, Pay in 4 against an on-chain credit line, subscriptions and euro or dollar send links, settled in USDC; buyers pay from any chain with CCTP.",
  "engines": {
    "node": ">=22.6.0"
  },
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "demo:local": "node scripts/demo-local.mjs",
    "demo:e2e": "node scripts/demo-e2e.cjs",
    "demo:e2e:split": "node scripts/demo-e2e-split.cjs",
    "e2e:local": "pnpm --filter @polaris/business e2e:local",
    "e2e:testnet": "node scripts/e2e-testnet.mjs",
    "e2e:testnet:collect": "E2E_PHASE=collect node scripts/e2e-testnet.mjs",
    "contracts:compile": "pnpm --filter @polarispay/contracts compile",
    "contracts:test": "pnpm --filter @polarispay/contracts test",
    "deploy:testnet": "pnpm --filter @polarispay/contracts deploy:testnet",
    "deploy:mainnet": "pnpm --filter @polarispay/contracts deploy:mainnet",
    "keeper": "pnpm --filter @polaris/keeper start",
    "indexer:local": "bash packages/indexer/scripts/wsl.sh local",
    "dryrun:mainnet": "node --import ./scripts/dryrun-loader.mjs scripts/dryrun-mainnet.mjs"
  }
}
